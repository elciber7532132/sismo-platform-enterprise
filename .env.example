POSTGRES_DB=sismo_platform
POSTGRES_USER=sismo_app
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://sismo_app:change-this-local-password@db:5432/sismo_platform
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Web Push (required for manual push and automatic phone alerts)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
AUTO_ALERT_MIN_MAGNITUDE=5.0
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=300
